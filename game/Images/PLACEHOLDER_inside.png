            <script nonce="a9c7b777a566d9028b504829e3f62305938a2092abf7c99af8b80e9b08993905">window.__PRELOADED_STATE__ = "{\"auth\":{\"isAuthenticated\":false,\"isLoggedInAs\":false,\"authScopes\":null,\"authInfoLoaded\":true,\"loginError\":null,\"loginInProgress\":false,\"logoutError\":null,\"logoutInProgress\":false,\"signupError\":null,\"signupInProgress\":false,\"confirmError\":null,\"confirmInProgress\":false},\"emailVerification\":{\"isVerified\":false,\"verificationError\":null,\"verificationInProgress\":false},\"hostedAssets\":{\"appAssets\":{\"translations\":\"/content/translations.json\",\"footer\":\"/content/footer.json\",\"topbar\":\"/content/top-bar.json\",\"branding\":\"/design/branding.json\",\"layout\":\"/design/layout.json\",\"userTypes\":\"/users/user-types.json\",\"userFields\":\"/users/user-fields.json\",\"categories\":\"/listings/listing-categories.json\",\"listingTypes\":\"/listings/listing-types.json\",\"listingFields\":\"/listings/listing-fields.json\",\"search\":\"/listings/listing-search.json\",\"transactionSize\":\"/transactions/minimum-transaction-size.json\",\"analytics\":\"/integrations/analytics.json\",\"googleSearchConsole\":\"/integrations/google-search-console.json\",\"maps\":\"/integrations/map.json\",\"localization\":\"/general/localization.json\",\"accessControl\":\"/general/access-control.json\"},\"pageAssetsData\":null,\"currentPageAssets\":[],\"version\":\"dWrTormMdSBF3XZ0eZGESQ\",\"inProgress\":false,\"error\":null,\"googleAnalyticsId\":\"G-5FQFM0YR43\"},\"marketplaceData\":{\"entities\":{\"listing\":{\"6731e50d-482b-4b27-b201-0a68b0892335\":{\"attributes\":{\"title\":\"PCYC Hornsby-Ku-Ring-Gai Boxing Room\",\"description\":\"PCYC Hornsby-Ku-Ring-Gai is the community’s largest indoor sporting precinct, and has been a part of the local community since 1968. PCYC Hornsby-Ku-Ring-Gai is proud to boast an amazing purpose-built facility consisting of a new health gym and boxing gym, multipurpose sports courts, world class gymnastics set up, café and a range of multipurpose rooms. We are a modern, safe and exciting club delivering our mission to get our community active in life.\\n\\nOur Boxing Room is professionally equipped - yes, the Ring is included! Your booking allows you full access to the space and its' amenities.\\n\\nWhether you're a community group, or simply members of the local community, we here at PCYC Hornsby-Ku-Ring-Gai welcome you! Need a space for a friendly, or looking for rainy day activities? Children's birthday party and not sure about the weather? Teambuilding? Reach out!\\n\\nEquipment is provided and Activity Supervisor available on request - unless of course YOU are the supervisor looking for the perfect space to host your own classes! \\n\\nOur facilities support numerous sports & recreation programs, school holiday programs, police run community programs and now you, too, can book space for your events and occasions.\\n\\nWhatever your requirements, we here at PCYC Hornsby-Ku-Ring-Gai have the space for you! Film and TV enquiries welcome.\\n\\n(According to PCYC terms & conditions, hirers will need to complete the membership form attached)\",\"publicData\":{\"location\":{\"address\":\"1 Park Ln, Waitara NSW 2077, Australia\",\"building\":null},\"allowHalfHourBooking\":true,\"allowedEvents\":[],\"bathroomTypes\":[\"accessible-disabled-bathrooms\",\"male-female-bathrooms\"],\"cleaningFee\":{\"amount\":0,\"currency\":\"AUD\"},\"cleaningFeeUnitPrice\":5000,\"conditionsOfHire\":{\"contentType\":\"application/pdf\",\"fileName\":\"PCYC_Club_Membership_Form_Vennu.pdf\",\"fileSize\":565635,\"updatedAt\":\"2024-07-31T03:59:43.000-00:00\"},\"dailyUnitType\":\"hour\",\"eventTypes\":[\"pop-up-performance\",\"film-photoshoot\",\"retreat-adventure\",\"corporate-work\",\"sport-exercise\",\"social-community\",\"party-occasion\",\"religion-faith\"],\"hourlyPrice\":136,\"hourlyPriceObject\":{\"amount\":13600,\"currency\":\"AUD\"},\"interiorAmenities\":[\"none\"],\"interiorFeatures\":\"Boxing Equipment/ Mats\",\"isTaxExempt\":\"no\",\"kitchenTypes\":[\"no-kitchen\"],\"listingType\":\"hourly-rental\",\"organizationDescription\":\"PCYC is a charity empowering young people to survive, and thrive, in partnership with the police and the community. As Australia's pre-eminent youth organisation, PCYC is all-inclusive and delivers on our mission to support young people in reaching their potential, developing skills, character and leadership. PCYC hosts a broad range of activities to suit all interests, and is proud to boast facilities and classes that cater to all ages and fitness levels. By training and playing at a PCYC, you're supporting our mission to empower youth, and give back to the community. What could be better?\",\"outdoorAmenities\":[\"none\"],\"quantitySelector\":\"number\",\"secondaryQuantitySelector\":\"day\",\"secondaryUnitType\":\"day\",\"spaceArea\":75,\"standingGuestsQuantity\":50,\"technology\":[\"wifi\",\"av-hire-sound\",\"heating-cooling\"],\"transactionProcessAlias\":\"default-booking/release-1\",\"transport\":[\"onsite-parking\",\"street-parking\",\"parking-station\",\"bus-route\",\"train-route\"],\"unitType\":\"hour\",\"workingHours\":{\"fri\":[{\"endTime\":\"21:00\",\"startTime\":\"06:00\"}],\"mon\":[{\"endTime\":\"21:00\",\"startTime\":\"06:00\"}],\"sat\":[{\"endTime\":\"17:00\",\"startTime\":\"06:00\"}],\"sun\":[{\"endTime\":\"18:00\",\"startTime\":\"08:00\"}],\"thu\":[{\"endTime\":\"21:00\",\"startTime\":\"06:00\"}],\"tue\":[{\"endTime\":\"21:00\",\"startTime\":\"06:00\"}],\"wed\":[{\"endTime\":\"21:00\",\"startTime\":\"06:00\"}]}},\"deleted\":false,\"geolocation\":{\"_sdkType\":\"LatLng\",\"lat\":-33.7091,\"lng\":151.106},\"createdAt\":\"2024-06-11T13:45:38.000Z\",\"state\":\"published\",\"availabilityPlan\":{\"type\":\"availability-plan/time\",\"timezone\":\"Australia/Sydney\"},\"price\":{\"_sdkType\":\"Money\",\"amount\":13600,\"currency\":\"AUD\"},\"metadata\":{\"extId\":\"508\",\"index\":\"483\",\"legacyAuthorId\":\"sW6-cL2uTaJH71d_yfwIPw\"}},\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-482b-4b27-b201-0a68b0892335\"},\"type\":\"listing\",\"relationships\":{\"author\":{\"data\":{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-8724-474d-981f-09249e4f928c\"},\"type\":\"user\"}},\"currentStock\":{\"data\":null},\"images\":{\"data\":[{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-33bb-48fa-9c81-cafa0ed55a7d\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-2789-4049-90e8-698961490369\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-01db-4d3a-a708-c37e306e1946\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-9a3a-4233-9598-76e4558f24e1\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-e85a-450c-b5c4-3b76d56735ec\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-e711-4b17-b358-1642c404089e\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-0bf4-4973-8e1e-63caa0d0cfcf\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-c774-4b21-8c27-078a11abfa5f\"},\"type\":\"image\"},{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-67d5-4065-a916-d6cdf0c2c8a9\"},\"type\":\"image\"}]}}}},\"image\":{\"6731e50d-2789-4049-90e8-698961490369\":{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-2789-4049-90e8-698961490369\"},\"type\":\"image\",\"attributes\":{\"variants\":{\"listing-card-6x\":{\"name\":\"listing-card-6x\",\"height\":1800,\"width\":2400,\"url\":\"https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-2789-4049-90e8-698961490369?auto=format&crop=edges&fit=crop&h=1800&w=2400&s=426afb86481963560dca67476049aac4\"},\"scaled-small\":{\"name\":\"scaled-small\",\"height\":213,\"width\":320,\"url\":\"https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-2789-4049-90e8-698961490369?auto=format&fit=clip&h=320&w=320&s=1475ac066c7df789c59a875182a35613\"},\"square-small2x\":{\"name\":\"sq