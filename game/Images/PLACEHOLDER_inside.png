retribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/683d12cb-b2ea-439e-8ab6-eefa99384f1f?auto=format&fit=clip&h=2400&w=2400&s=57fda1a60823015243cf56a63acd766f\"},\"listing-card-4x\":{\"name\":\"listing-card-4x\",\"height\":1200,\"width\":1600,\"url\":\"https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/683d12cb-b2ea-439e-8ab6-eefa99384f1f?auto=format&crop=edges&fit=crop&h=1200&w=1600&s=ea7f331b8fee4fcab2f5f10fbd62da60\"},\"scaled-large\":{\"name\":\"scaled-large\",\"height\":854,\"width\":1024,\"url\":\"https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/683d12cb-b2ea-439e-8ab6-eefa99384f1f?auto=format&fit=clip&h=1024&w=1024&s=a3394c4bff45aa7d84e1b392b156757d\"},\"listing-card-2x\":{\"name\":\"listing-card-2x\",\"height\":600,\"width\":800,\"url\":\"https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/683d12cb-b2ea-439e-8ab6-eefa99384f1f?auto=format&crop=edges&fit=crop&h=600&w=800&s=76a980857a35568f7d5e3e1e6e7c15fe\"}}}}},\"user\":{\"6731e50d-8724-474d-981f-09249e4f928c\":{\"attributes\":{\"profile\":{\"abbreviatedName\":\"DK\",\"displayName\":\"PCYC Hornsby-Ku-Ring-Gai\",\"bio\":\"PCYC NSW is a charity empowering young people to reach their potential through police and community partnerships.\\n\\nPCYC Hornsby Ku-Ring-Gai has been a part of the local community since 1968, and its current purpose-built facility since September 2017. PCYC Hornsby Ku-Ring-Gai is proud to boast an amazing facility consisting of a new health gym and boxing gym, multipurpose sports courts, world-class gymnastics set up, café and a range of multipurpose rooms. We are a modern, safe and exciting club delivering our mission to get our community active in life.\\n\\nWe offer programs and activities for all ages including gymnastics, gym and fitness, boxing, learn to play sports programs, driver education programs, junior and senior sports competitions, court sports, Out of Hours School Care (OOSH), and loads more.\\n\\nPlease get in touch if you want to find out more — we would love to hear from you.\\n\",\"publicData\":{\"communityAgreement\":\"yes\",\"location\":{\"latitude\":-33.7091,\"longitude\":151.106}},\"metadata\":{\"delegatedUsers\":[\"6731e50d-ea1e-457c-879a-b9288c174a51\",\"681aa1f8-7019-4d42-915e-50fff7f5765d\",\"67c789d8-5324-48cb-9d0c-607499f5686e\"],\"extId\":\"sW6-cL2uTaJH71d_yfwIPw\",\"hasOldTransactions\":true,\"index\":\"2605\",\"username\":\"pcychornsby\"}},\"banned\":false,\"deleted\":false,\"createdAt\":\"2024-05-23T02:39:21.000Z\",\"state\":\"active\"},\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"6731e50d-8724-474d-981f-09249e4f928c\"},\"type\":\"user\",\"relationships\":{\"profileImage\":{\"data\":{\"id\":{\"_sdkType\":\"UUID\",\"uuid\":\"683d12cb-b2ea-439e-8ab6-eefa99384f1f\"},\"type\":\"image\"}}}}}}},\"paymentMethods\":{\"addPaymentMethodInProgress\":null,\"addPaymentMethodError\":null,\"deletePaymentMethodInProgress\":null,\"deletePaymentMethodError\":null,\"createStripeCustomerInProgress\":null,\"createStripeCustomerError\":null,\"stripeCustomer\":null},\"routing\":{\"currentLocation\":null,\"currentCanonicalPath\":null},\"stripe\":{\"confirmCardPaymentInProgress\":false,\"confirmCardPaymentError\":null,\"handleCardSetupInProgress\":false,\"handleCardSetupError\":null,\"paymentIntent\":null,\"setupIntent\":null,\"retrievePaymentIntentInProgress\":false,\"retrievePaymentIntentError\":null},\"stripeConnectAccount\":{\"createStripeAccountInProgress\":false,\"createStripeAccountError\":null,\"updateStripeAccountInProgress\":false,\"updateStripeAccountError\":null,\"fetchStripeAccountInProgress\":false,\"fetchStripeAccountError\":null,\"getAccountLinkInProgress\":false,\"getAccountLinkError\":null,\"stripeAccount\":null,\"stripeAccountFetched\":false},\"ui\":{\"disableScrollRequests\":[]},\"user\":{\"currentUser\":null,\"currentUserShowTimestamp\":0,\"currentUserShowError\":null,\"currentUserHasListings\":false,\"currentUserHasListingsError\":null,\"currentUserNotificationCount\":0,\"cur