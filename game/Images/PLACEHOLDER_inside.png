      })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');</script><script data-rh="true" id="GoogleMapsApi" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAzZGYtfmI2hVDtSDPJaUOtLkG4XM_kYgs&amp;libraries=places" crossOrigin="true"></script><script data-rh="true" id="page-schema" type="application/ld+json">{"@context":"http://schema.org","@graph":[{"@context":"http://schema.org","@type":"Product","description":"PCYC Hornsby-Ku-Ring-Gai is the community’s largest indoor sporting precinct, and has been a part of the local community since 1968. PCYC Hornsby-Ku-Ring-Gai is proud to boast an amazing purpose-built facility consisting of a new health gym and boxing gym, multipurpose sports courts, world class gymnastics set up, café and a range of multipurpose rooms. We are a modern, safe and exciting club delivering our mission to get our community active in life.\n\nOur Boxing Room is professionally equipped - yes, the Ring is included! Your booking allows you full access to the space and its' amenities.\n\nWhether you're a community group, or simply members of the local community, we here at PCYC Hornsby-Ku-Ring-Gai welcome you! Need a space for a friendly, or looking for rainy day activities? Children's birthday party and not sure about the weather? Teambuilding? Reach out!\n\nEquipment is provided and Activity Supervisor available on request - unless of course YOU are the supervisor looking for the perfect space to host your own classes! \n\nOur facilities support numerous sports & recreation programs, school holiday programs, police run community programs and now you, too, can book space for your events and occasions.\n\nWhatever your requirements, we here at PCYC Hornsby-Ku-Ring-Gai have the space for you! Film and TV enquiries welcome.\n\n(According to PCYC terms & conditions, hirers will need to complete the membership form attached)","name":"PCYC Hornsby-Ku-Ring-Gai Boxing Room | Vennu","image":["https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-33bb-48fa-9c81-cafa0ed55a7d?auto=format&crop=edges&fit=crop&h=600&w=800&s=871b82f5c5dee87fd8e75c7de5a24561","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-2789-4049-90e8-698961490369?auto=format&crop=edges&fit=crop&h=600&w=800&s=d589e42673137132dde6e5084658c1b1","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-01db-4d3a-a708-c37e306e1946?auto=format&crop=edges&fit=crop&h=600&w=800&s=44e752e39dd117a3a8f25fa8c090c023","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-9a3a-4233-9598-76e4558f24e1?auto=format&crop=edges&fit=crop&h=600&w=800&s=dac2b35ba07c0851682d75ffe658fc6f","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-e85a-450c-b5c4-3b76d56735ec?auto=format&crop=edges&fit=crop&h=600&w=800&s=ba52970c1400e0d86c54eedfd53735ee","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-e711-4b17-b358-1642c404089e?auto=format&crop=edges&fit=crop&h=600&w=800&s=56a5a1dbbb0eca9f4e2ac6cd2383eae1","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-0bf4-4973-8e1e-63caa0d0cfcf?auto=format&crop=edges&fit=crop&h=600&w=800&s=0a437d6d64e3423f3e3345121c9c3b98","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-c774-4b21-8c27-078a11abfa5f?auto=format&crop=edges&fit=crop&h=600&w=800&s=18ea5ac8490a6e711a4113d5efba527e","https://sharetribe.imgix.net/6729902e-59d7-4694-96e3-32ee5a0863bd/6731e50d-67d5-4065-a916-d6cdf0c2c8a9?auto=format&crop=edges&fit=crop&h=600&w=800&s=954b3665000eaad9cc5828aefbb112dd"],"offers":{"@type":"Offer","url":"https://vennu.com.au/l/pcyc-hornsby-ku-ring-gai-boxing-room/483?srsltid=AYCX9vJUf7hHQM_MOWrsykGeyrhMPIpnRgIW9GOKDYM1An2zSNbKNDfA","price":"136.00","priceCurrency":"AUD"}},{"@context":"http://schema.org","@type":"Organization","@id":"https://vennu.com.au#organization","url":"https://vennu.com.au","name":"Vennu","sameAs":[]},{"@context":"http://schema.org","@type":"WebSite","url":"https://vennu.com.au","description":"An online marketplace.","name":"Vennu"}]}</script>
